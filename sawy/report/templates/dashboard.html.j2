<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ client.name }} · Tablero</title>
<meta name="description" content="Estado del negocio y acciones de la semana para {{ client.name }}.">
<style>
:root {
  color-scheme: light;
  --page: #f9f9f7; --surface: #fcfcfb; --surface-2: #f3f2ee;
  --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
  --grid: #e1e0d9; --axis: #c3c2b7; --border: rgba(11,11,11,.10);
  --pos: #2a78d6; --neg: #e34948; --s1: #2a78d6; --s2: #eb6834;
  --good: #0ca30c; --good-ink: #006300; --warn: #fab219; --serious: #ec835a; --critical: #d03b3b;
  --accent-wash: #eaf2fc;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --page: #0d0d0d; --surface: #1a1a19; --surface-2: #232321;
    --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
    --grid: #2c2c2a; --axis: #383835; --border: rgba(255,255,255,.10);
    --pos: #3987e5; --neg: #e66767; --s1: #3987e5; --s2: #d95926;
    --good-ink: #0ca30c; --accent-wash: #16263a;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d; --surface: #1a1a19; --surface-2: #232321;
  --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
  --grid: #2c2c2a; --axis: #383835; --border: rgba(255,255,255,.10);
  --pos: #3987e5; --neg: #e66767; --s1: #3987e5; --s2: #d95926;
  --good-ink: #0ca30c; --accent-wash: #16263a;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--page); color: var(--ink);
  font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
.wrap { max-width: 1120px; margin: 0 auto; padding: 32px 16px 64px; }
header.top { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; justify-content: space-between; margin-bottom: 24px; }
.eyebrow { font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); margin: 0 0 4px; }
h1 { font-size: 28px; line-height: 1.2; margin: 0; font-weight: 650; }
h2 { font-size: 20px; line-height: 1.3; margin: 0 0 4px; font-weight: 650; }
h3 { font-size: 16px; margin: 0 0 4px; font-weight: 600; }
.sub { color: var(--ink-2); margin: 0 0 16px; }
.meta { color: var(--muted); font-size: 13px; text-align: right; }
section { margin-top: 40px; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
.grid { display: grid; gap: 16px; }
.g2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
.g4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }

/* Hero */
.hero { display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: center; }
@media (max-width: 820px) { .hero { grid-template-columns: 1fr; } }
.question { font-size: 15px; color: var(--ink-2); margin: 0; }
.answer { font-size: 22px; font-weight: 650; margin: 2px 0 6px; }
.hero-figure { font-size: 52px; line-height: 1.05; font-weight: 650; letter-spacing: -.01em; }
.hero-figure.neg { color: var(--ink); }
.hero-caption { color: var(--ink-2); font-size: 14px; margin-top: 4px; }
.headline { margin: 16px 0 0; font-size: 17px; }
.summary { margin: 12px 0 0; padding-left: 18px; color: var(--ink-2); }
.summary li { margin: 4px 0; }

/* KPI tiles */
.tile .label { font-size: 13px; color: var(--ink-2); }
.tile .value { font-size: 26px; font-weight: 650; margin-top: 2px; }
.tile .hint { font-size: 12px; color: var(--muted); margin-top: 2px; }
.flow { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 20px; }

/* Actions */
.actions { counter-reset: act; display: grid; gap: 12px; }
.action { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; }
.action::before {
  counter-increment: act; content: counter(act);
  width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
  background: var(--accent-wash); color: var(--ink); font-weight: 650; font-size: 15px;
}
.action p { margin: 2px 0 0; color: var(--ink-2); }
.refs { margin-top: 6px; display: flex; gap: 6px; flex-wrap: wrap; }
.ref { font-size: 12px; color: var(--ink-2); text-decoration: none; border: 1px solid var(--border); border-radius: 999px; padding: 1px 8px; }
.ref:hover { background: var(--surface-2); }

/* Badges (estado: siempre ícono + texto, nunca solo color) */
.badge { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--ink-2); white-space: nowrap; }
.dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
.sev-alta .dot { background: var(--critical); } .sev-media .dot { background: var(--serious); } .sev-baja .dot { background: var(--muted); }
.v-yes .dot { background: var(--good); } .v-part .dot { background: var(--warn); } .v-no .dot { background: var(--critical); }

/* Toggle */
.toolbar { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: 12px 0 16px; }
.seg { display: inline-flex; background: var(--surface-2); border-radius: 10px; padding: 3px; border: 1px solid var(--border); flex-wrap: wrap; }
.seg button {
  font: inherit; font-size: 14px; border: 0; background: transparent; color: var(--ink-2);
  padding: 6px 12px; border-radius: 8px; cursor: pointer;
}
.seg button[aria-pressed="true"] { background: var(--surface); color: var(--ink); font-weight: 600; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
.seg button:focus-visible { outline: 2px solid var(--pos); outline-offset: 1px; }

.fig { margin: 8px 0 0; }
/* Barras horizontales */
.hb { display: grid; gap: 6px; margin-top: 8px; }
.hb-row { display: grid; grid-template-columns: minmax(90px, 34%) 1fr auto; gap: 10px; align-items: center; padding: 3px 4px; border-radius: 6px; outline: none; }
.hb-row:hover, .hb-row:focus-visible { background: var(--surface-2); }
.hb-label { font-size: 13px; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hb-track { position: relative; height: 18px; }
.hb-zero { position: absolute; top: -3px; bottom: -3px; width: 1px; background: var(--axis); }
.hb-bar { position: absolute; top: 0; bottom: 0; }
.hb-bar.pos { background: var(--pos); border-radius: 0 4px 4px 0; }
.hb-bar.neg { background: var(--neg); border-radius: 4px 0 0 4px; }
.hb-val { font-size: 13px; color: var(--ink); text-align: right; min-width: 72px; font-variant-numeric: tabular-nums; }
/* Columnas */
.col-chart { display: flex; flex-direction: column; }
.col-plot { position: relative; flex: 1; margin-left: 64px; }
.gl { position: absolute; left: 0; right: 0; height: 0; border-top: 1px solid var(--grid); }
.gl.zero { border-top-color: var(--axis); }
.gl span { position: absolute; right: calc(100% + 8px); transform: translateY(-50%); font-size: 12px; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
.cols { position: absolute; inset: 0; display: flex; }
.col { flex: 1; position: relative; outline: none; }
.col:hover, .col:focus-visible { background: rgba(127,127,127,.07); }
.col-bar { position: absolute; left: 50%; transform: translateX(-50%); width: min(24px, 60%); }
.col-bar.pos { background: var(--pos); border-radius: 4px 4px 0 0; }
.col-bar.neg { background: var(--neg); border-radius: 0 0 4px 4px; }
.col-x { display: flex; margin-left: 64px; margin-top: 6px; }
.col-x span { flex: 1; text-align: center; font-size: 12px; color: var(--muted); }
/* Líneas */
.ln-chart { display: flex; flex-direction: column; }
.ln-plot { position: relative; flex: 1; margin-left: 40px; margin-right: 112px; }
.ln-plot svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.ln-dot { position: absolute; width: 10px; height: 10px; border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 0 2px var(--surface); outline: none; }
.ln-dot::after { content: ""; position: absolute; inset: -8px; }
.ln-dot:hover, .ln-dot:focus-visible { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--axis); }
.ln-end { position: absolute; left: calc(100% + 12px); transform: translateY(-50%); font-size: 12px; color: var(--ink-2); white-space: nowrap; }
.ln-x { margin-left: 40px; margin-right: 112px; justify-content: space-between; }
.ln-x span { flex: 0 0 auto; }
#tip { position: fixed; z-index: 10; pointer-events: none; background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-size: 13px; line-height: 1.45; box-shadow: 0 4px 14px rgba(0,0,0,.14); max-width: 280px; }
.method-explain { font-size: 14px; color: var(--ink-2); margin: 0 0 12px; }
.legend { display: flex; gap: 16px; font-size: 13px; color: var(--ink-2); margin-top: 4px; flex-wrap: wrap; }
.legend i { display: inline-block; width: 14px; height: 3px; border-radius: 2px; vertical-align: middle; margin-right: 6px; }
.legend i.sq { width: 10px; height: 10px; border-radius: 3px; }
details { margin-top: 10px; }
summary { cursor: pointer; color: var(--ink-2); font-size: 13px; }
table { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 8px; font-variant-numeric: tabular-nums; }
th, td { text-align: right; padding: 6px 8px; border-bottom: 1px solid var(--grid); }
th:first-child, td:first-child { text-align: left; }
th { color: var(--muted); font-weight: 500; font-size: 12px; }
.table-scroll { overflow-x: auto; }

/* Findings */
.findings { display: grid; gap: 12px; }
.finding { scroll-margin-top: 16px; }
.finding:target { outline: 2px solid var(--pos); }
.finding .head { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; flex-wrap: wrap; }
.finding p { margin: 6px 0 0; color: var(--ink-2); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.chip { font-size: 12px; background: var(--surface-2); border-radius: 6px; padding: 2px 8px; color: var(--ink-2); }
.tag { font-size: 12px; color: var(--muted); }

.belief { display: grid; gap: 4px; }
.belief q { font-style: italic; color: var(--ink); }
.belief p { margin: 0; color: var(--ink-2); }

ul.plain { margin: 0; padding-left: 18px; color: var(--ink-2); }
ul.plain li { margin: 6px 0; }
.note { font-size: 14px; color: var(--ink-2); }
footer { margin-top: 48px; color: var(--muted); font-size: 13px; display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
.banner { background: var(--surface-2); border-radius: 8px; padding: 8px 12px; font-size: 13px; color: var(--ink-2); margin-top: 12px; }
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <div>
      <p class="eyebrow">Tablero de negocio</p>
      <h1>{{ client.name }}</h1>
    </div>
    <div class="meta">{{ period }} · datos hasta el {{ reference_date }}<br>{{ source_label }}</div>
  </header>

  <!-- 1. ¿Estás ganando plata? -->
  <div class="card">
    <div class="hero">
      <div>
        <p class="question">¿Estás ganando plata?</p>
        <p class="answer">{{ "Todavía no." if kpis.net_value < 0 else "Sí." }}</p>
        <div class="hero-figure">{{ kpis.net }}</div>
        <div class="hero-caption">resultado de {{ kpis.months_total }} meses · {{ kpis.months_negative }} de {{ kpis.months_total }} meses en rojo</div>
        <p class="headline">{{ narrative.headline }}</p>
        <ul class="summary">{% for s in narrative.summary %}<li>{{ s }}</li>{% endfor %}</ul>
        {% if narrative_note %}<div class="banner">{{ narrative_note }}</div>{% endif %}
      </div>
      <div>
        <h3>Resultado de cada mes</h3>
        <figure class="fig" aria-label="Resultado mensual: ganancia o pérdida de cada mes">{{ charts.monthly|safe }}</figure>
        <div class="legend"><span><i class="sq" style="background:var(--pos)"></i>Ganancia</span><span><i class="sq" style="background:var(--neg)"></i>Pérdida</span></div>
      </div>
    </div>
  </div>

  <!-- 2. De dónde sale el resultado -->
  <div class="grid g4" style="margin-top:16px" aria-label="Cómo se llega al resultado">
    <div class="card tile"><div class="label">Facturaste</div><div class="value">{{ kpis.revenue }}</div><div class="hint">neto de descuentos y devoluciones</div></div>
    <div class="card tile"><div class="label">Te quedó después de pagar la mercadería</div><div class="value">{{ kpis.gross_margin }}</div><div class="hint">{{ kpis.gross_margin_pct }} de lo facturado</div></div>
    <div class="card tile"><div class="label">Gastos variables</div><div class="value">{{ kpis.variable }}</div><div class="hint">flete, packaging, comisiones</div></div>
    <div class="card tile"><div class="label">Gastos fijos</div><div class="value">{{ kpis.fixed }}</div><div class="hint">alquiler, sueldos, energía</div></div>
  </div>

  <!-- 3. Acciones -->
  <section aria-labelledby="h-actions">
    <h2 id="h-actions">Qué hacer esta semana</h2>
    <p class="sub">Ordenadas por impacto. Cada una enlaza al dato que la respalda.</p>
    <div class="card actions">
      {% for a in narrative.actions %}
      <div class="action">
        <div>
          <h3>{{ a.title }}</h3>
          <p>{{ a.why }}</p>
          <div class="refs">{% for fid in a.finding_ids %}<a class="ref" href="#{{ fid }}">Ver dato {{ fid }}</a>{% endfor %}</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- 4. Con qué gana y con qué pierde -->
  <section aria-labelledby="h-where">
    <h2 id="h-where">¿Con qué ganás y con qué perdés?</h2>
    <p class="sub">Lo que deja cada canal y cada producto después de pagar la mercadería y los gastos variables (antes de los gastos fijos).</p>
    <div class="toolbar">
      <div class="seg" role="group" aria-label="Cómo repartir los gastos compartidos">
        {% for m, d in charts.by_method.items() %}<button type="button" data-m="{{ m }}" aria-pressed="{{ 'true' if m == charts.default_method else 'false' }}">{{ d.label }}</button>{% endfor %}
      </div>
    </div>
    {% for m, d in charts.by_method.items() %}
    <div class="method-panel" data-m="{{ m }}"{% if m != charts.default_method %} hidden{% endif %}>
      <p class="method-explain">Los gastos compartidos (como el flete) se reparten {{ d.explain }}.{% if m == charts.default_method %} Es el criterio principal.{% else %} Es un criterio alternativo, para ver qué tan firme es la conclusión.{% endif %}</p>
      <div class="grid g2">
        <div class="card">
          <h3>Por canal</h3>
          {{ d.channels|safe }}
          <details><summary>Ver tabla</summary><div class="table-scroll"><table>
            <thead><tr><th scope="col">Canal</th><th scope="col">Facturación</th><th scope="col">Margen bruto</th><th scope="col">Gastos variables</th><th scope="col">Deja</th><th scope="col">% de lo vendido</th></tr></thead>
            <tbody>{% for r in d.channel_rows %}<tr><td>{{ r.name }}</td><td>{{ r.revenue }}</td><td>{{ r.gross_margin }}</td><td>{{ r.variable }}</td><td>{{ r.contribution }}</td><td>{{ r.pct }}</td></tr>{% endfor %}</tbody>
          </table></div></details>
        </div>
        <div class="card">
          <h3>Por producto</h3>
          {{ d.products|safe }}
          <details><summary>Ver tabla</summary><div class="table-scroll"><table>
            <thead><tr><th scope="col">Producto</th><th scope="col">Facturación</th><th scope="col">Deja</th><th scope="col">% de lo vendido</th></tr></thead>
            <tbody>{% for r in d.product_rows %}<tr><td>{{ r.name }}</td><td>{{ r.revenue }}</td><td>{{ r.contribution }}</td><td>{{ r.pct }}</td></tr>{% endfor %}</tbody>
          </table></div></details>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>

  {% if narrative.beliefs %}
  <!-- 5. Creencias -->
  <section aria-labelledby="h-beliefs">
    <h2 id="h-beliefs">Lo que creías vs. lo que dicen los números</h2>
    <p class="sub">Contrastamos lo que nos contaste con los datos del sistema.</p>
    <div class="grid g2">
      {% for b in narrative.beliefs %}
      {% set cls = {"se confirma": "v-yes", "en parte": "v-part", "no se confirma": "v-no"}[b.verdict] %}
      <div class="card belief">
        <span class="badge {{ cls }}"><span class="dot" aria-hidden="true"></span>{{ b.verdict|capitalize }}</span>
        <q>{{ b.belief }}</q>
        <p>{{ b.explanation }}</p>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- 6. Pesos vs volumen -->
  {% if charts.trend %}
  <section aria-labelledby="h-trend">
    <h2 id="h-trend">¿Vendés más, o solo facturás más?</h2>
    <p class="sub">Facturación en pesos y volumen vendido, los dos con el primer mes = 100. Si la línea de pesos sube y la de volumen baja, el crecimiento es por precios, no por ventas.</p>
    <div class="card">
      <figure class="fig" aria-label="Facturación y volumen, primer mes = 100">{{ charts.trend|safe }}</figure>
      <div class="legend"><span><i style="background:var(--s1)"></i>Facturación ($)</span><span><i style="background:var(--s2)"></i>Volumen ({{ client.base_unit }})</span></div>
    </div>
  </section>
  {% endif %}

  <!-- 7. Todos los hallazgos -->
  <section aria-labelledby="h-findings">
    <h2 id="h-findings">Todos los datos detrás de las recomendaciones</h2>
    <p class="sub">Calculados directamente de los datos del sistema, sin IA.</p>
    <div class="findings">
      {% for f in findings %}
      <article class="card finding" id="{{ f.id }}">
        <div class="head">
          <h3>{{ f.title }}</h3>
          <span class="badge sev-{{ f.severity }}"><span class="dot" aria-hidden="true"></span>Prioridad {{ f.severity }} · {{ f.id }}</span>
        </div>
        <p>{{ f.detail }}</p>
        {% if f.assumption %}<p class="tag">Depende de cómo se repartan los gastos compartidos.</p>{% endif %}
        {% if f.related %}<div class="chips">{% for e in f.related[:20] %}<span class="chip">{{ e }}</span>{% endfor %}</div>{% endif %}
      </article>
      {% endfor %}
    </div>
  </section>

  <!-- 8. Cómo calculamos -->
  <section aria-labelledby="h-how">
    <h2 id="h-how">Cómo calculamos esto</h2>
    <div class="grid g2">
      <div class="card">
        <h3>Supuestos</h3>
        <ul class="plain">{% for a in assumptions %}<li>{{ a }}</li>{% endfor %}</ul>
      </div>
      <div class="card">
        <h3>Qué encontramos en los datos</h3>
        <ul class="plain">{% for n in notes %}<li>{{ n.message }}</li>{% endfor %}</ul>
        {% if skipped %}<p class="note">Análisis que no aplican a estos datos: {% for s in skipped %}{{ s.detector }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
      </div>
    </div>
  </section>

  <footer>
    <span>Generado el {{ generated_at }} · criterio de reparto por defecto: {{ default_method_label|lower }}</span>
    <span>{{ source_label }}</span>
  </footer>
</div>

<div id="tip" role="tooltip" hidden></div>
<script>
(function () {
  // Selector de criterio de reparto
  const buttons = document.querySelectorAll('.seg button');
  buttons.forEach(b => b.addEventListener('click', () => {
    buttons.forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll('.method-panel').forEach(p => { p.hidden = p.dataset.m !== b.dataset.m; });
  }));
  // Tooltip único para todas las marcas (mouse, teclado y toque)
  const tip = document.getElementById('tip');
  const show = (el, x, y) => {
    tip.innerHTML = el.dataset.tip; tip.hidden = false;
    const r = tip.getBoundingClientRect();
    const left = Math.min(Math.max(8, x + 14), window.innerWidth - r.width - 8);
    const top = y + 14 + r.height > window.innerHeight ? y - r.height - 14 : y + 14;
    tip.style.left = left + 'px'; tip.style.top = top + 'px';
  };
  const hide = () => { tip.hidden = true; };
  document.querySelectorAll('[data-tip]').forEach(el => {
    el.addEventListener('pointermove', e => show(el, e.clientX, e.clientY));
    el.addEventListener('pointerleave', hide);
    el.addEventListener('focus', () => { const r = el.getBoundingClientRect(); show(el, r.left + r.width / 2, r.top + r.height / 2); });
    el.addEventListener('blur', hide);
  });
  window.addEventListener('scroll', hide, { passive: true });
})();
</script>
</body>
</html>
