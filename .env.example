# -----------------------------------------------------------------------------
# Copiá este archivo como `.env` (cp .env.example .env) y completá lo que uses.
# TODO es opcional: sin clave el proyecto corre igual. Los textos del
# dashboard salen de la caché de IA versionada en el repo o, si los datos
# cambiaron, de una plantilla determinística sin IA.
# El archivo .env NUNCA se sube al repo (está en .gitignore).
# -----------------------------------------------------------------------------

# Clave de IA: completá UNA de las dos.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Proveedor a usar: gemini | openai. Vacío = el primero que tenga clave (Gemini primero).
LLM_PROVIDER=

# Modelo. Vacío = default del proveedor (gemini-3.8-flash / gpt-4.1-mini).
# Tiene que soportar salida JSON.
LLM_MODEL=

# Cliente a procesar: nombre de la carpeta dentro de clients/.
SAWY_CLIENT=tostadero_ruta9
